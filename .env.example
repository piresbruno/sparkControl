PORT=5555
# Listen address. Non-loopback startup fails closed because this release does not
# authenticate direct LAN clients. Keep loopback and use docs/REMOTE-ACCESS.md.
BIND_HOST=127.0.0.1
# Tokenless remote bind. Default is 1; set 0 to fail closed without SPARKDASH_TOKEN.
SPARKDASH_ALLOW_OPEN_REMOTE=1
LLM_PORT=8888
POLL_INTERVAL_GPU=2000
POLL_INTERVAL_CPU=2000
POLL_INTERVAL_NETWORK=2000
POLL_INTERVAL_STORAGE=5000
POLL_INTERVAL_LLM=2000
POLL_INTERVAL_BANDWIDTH=1000
# Optional: ssh -i path inside the container when the key is not a default OpenSSH name.
# The mounted private key must be mode 600 on the host.
# SSH_IDENTITY_FILE=/root/.ssh/id_ed25519
# Reuse authenticated SSH transports for remote polling. Set to 0 to disable.
SSH_CONTROL_PERSIST_SECONDS=60

# ── Serving / Serve (plan SERVE) ─────────────────────────────────
# Script-library dirs: runtime (edited by users) and the repo seed source
# copied into it on first boot (never overwrites).
# SPARKDASH_SERVING_CONFIG_DIR=/app/config/serving
# SPARKDASH_SERVING_SOURCE_DIR=/app/serving
# Node-local "run by path" id map (persisted derived ids).
# SPARKDASH_PATH_SCRIPTS_PATH=/app/config/serving/path-scripts.json
# SPARKDASH_RUN_PORTS_PATH=/app/config/serving/run-ports.json
# Serve state files (registered recipe folders + deployments + job states).
# SPARKDASH_SERVE_RECIPES_PATH=/app/config/serve-recipes.json
# SPARKDASH_SERVE_DEPLOYMENTS_PATH=/app/config/serve-deployments.json
# Remote job state (downloads/sync/recipe-run drivers).
# SPARKDASH_JOBS_STATE_PATH=/app/config/modelctl-jobs.json
